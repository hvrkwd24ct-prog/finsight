<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The save panel writes wherever the user points it, and nowhere else. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!--
	  There is deliberately no com.apple.security.network.client here. The app ships one HTML
	  file with React, Babel and pdf.js inlined and contacts nothing; without the entitlement
	  the sandbox refuses an outbound connection even if something inside the web layer ever
	  tried to make one. It is the same promise the page's Content-Security-Policy makes,
	  enforced a second time by the operating system.
	-->
</dict>
</plist>
